# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats which slows down builds. Disable it.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

pre_install do |installer|
  # Fix llama_cpp_dart: ensure Llama.xcframework exists in the plugin's ios directory
  project_framework = File.join(__dir__, 'Frameworks', 'Llama.xcframework')
  
  # Search for any llama_cpp_dart plugin directories in pub cache or workspace
  search_patterns = [
    File.join(__dir__, 'Flutter', 'ephemeral', '.symlinks', 'plugins', 'llama_cpp_dart', 'ios'),
    File.join(__dir__, '..', '**', 'llama_cpp_dart*', 'ios')
  ]
  
  Dir.glob(search_patterns).each do |ios_dir|
    target_framework = File.join(ios_dir, 'Llama.xcframework')
    unless File.directory?(target_framework)
      parent_dist = File.expand_path(File.join(ios_dir, '..', 'dist', 'Llama.xcframework'))
      if File.directory?(parent_dist)
        puts "[CarePulse Fix] Copying #{parent_dist} -> #{target_framework}"
        FileUtils.cp_r(parent_dist, target_framework)
      elsif File.directory?(project_framework)
        puts "[CarePulse Fix] Copying project framework #{project_framework} -> #{target_framework}"
        FileUtils.cp_r(project_framework, target_framework)
      end
    end
  end
end

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
      config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
      config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
      
      # Prevent symbol stripping for native FFI bindings
      config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      config.build_settings['STRIP_STYLE'] = 'debugging'
      config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
      config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'YES'
    end
  end
end
